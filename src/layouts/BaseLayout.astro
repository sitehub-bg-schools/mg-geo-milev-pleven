---
import "../styles/global.css";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { school } from "../data/school.ts";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = `${school.name} — ${school.city}. ${school.taglines.primary}`,
  // Default OG card: 1200×630 brand-gradient SVG with ГМ monogram and
  // the school's full name. Most modern social platforms accept SVG;
  // a PNG fallback can be regenerated post-launch via any rasteriser.
  ogImage = "/og-default.svg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const fullTitle = title.includes(school.shortName) ? title : `${title} — ${school.shortName}`;
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content={school.shortName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${school.name} — ${school.city}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin).toString()} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">Към съдържанието</a>
    <AnnouncementBar />
    <slot />
    <CookieBanner />
  </body>
</html>
