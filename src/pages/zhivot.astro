---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import HubCard from "../components/HubCard.astro";

const sections: { title: string; description: string; href?: string }[] = [
  { title: "Новини", description: "Актуални съобщения, събития и постижения.", href: "/novini" },
  { title: "Галерия", description: "Снимки и моменти от училищния живот.", href: "/galeriya" },
  { title: "Събития", description: "Календар на предстоящите събития и изяви." },
  { title: "Клубове и занимания по интереси", description: "Извънкласни дейности и групи по интереси." },
  { title: "Ученически съвет", description: "Ученическото самоуправление в гимназията." },
];
---

<BaseLayout
  title="Живот в училище"
  description="Новини, събития, галерия, клубове и ученически съвет на МГ „Гео Милев“ — Плевен."
>
  <Header />
  <main id="main" class="flex-1">
    <PageHero
      eyebrow="Живот в училище"
      title="Ученически живот"
      lede="Новините, събитията, галерията, клубовете и ученическото самоуправление на гимназията."
    />
    <section class="container py-12 sm:py-16">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sections.map((s) => (
          <li>
            <HubCard title={s.title} description={s.description} href={s.href} />
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</BaseLayout>
