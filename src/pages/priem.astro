---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import BalCalculator from "../components/BalCalculator.astro";
import { school } from "../data/school.ts";
import { admissionProfiles, admissionsYear } from "../data/admissions.ts";

const steps = [
  { n: 1, label: "НВО по Български език и литература и по Математика (по график на МОН)." },
  { n: 2, label: "Подаване на заявление с желаните профили в системата на МОН." },
  { n: 3, label: "Класиране по бал и обявяване на резултатите." },
  { n: 4, label: "Записване в училището с оригиналните документи." },
];

const requiredDocs = [
  "Свидетелство за завършено основно образование (оригинал).",
  "Служебна бележка с резултатите от НВО.",
  "Заявление по образец (при записване).",
];
---

<BaseLayout
  title="Прием"
  description={`Прием след 7. клас в ${school.name} — профили, калкулатор за бал, балообразуващи предмети, важни дати и необходими документи за учебната ${admissionsYear} г.`}
>
  <Header />

  <main id="main" class="flex-1">
    <PageHero
      eyebrow="Прием"
      title="Прием след 7. клас"
      lede={`Профилите за учебната ${admissionsYear} г., калкулатор за ориентировъчен бал, важните стъпки по графика на МОН и необходимите документи.`}
    />

    {/* Защо МГ — proof strip */}
    <section class="bg-brand-700 text-white">
      <div class="container py-10 sm:py-12">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-brand-100">
              Защо МГ „Гео Милев“
            </p>
            <h2 class="mt-2 font-display text-2xl font-bold sm:text-3xl">
              Традиция, резултати и силна подготовка
            </h2>
          </div>
          <a
            href="/postizhenia"
            class="text-sm font-semibold text-accent-200 hover:text-white"
          >
            Виж постиженията →
          </a>
        </div>
        <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div class="rounded-xl bg-white/10 px-5 py-4 ring-1 ring-white/20">
            <dt class="text-xs uppercase tracking-wider text-brand-100">Профила</dt>
            <dd class="mt-1 font-mono text-3xl font-bold">{school.specializations.length}</dd>
          </div>
          <div class="rounded-xl bg-white/10 px-5 py-4 ring-1 ring-white/20">
            <dt class="text-xs uppercase tracking-wider text-brand-100">Преподаватели</dt>
            <dd class="mt-1 font-mono text-3xl font-bold">{school.stats.teachers}+</dd>
          </div>
          <div class="rounded-xl bg-white/10 px-5 py-4 ring-1 ring-white/20">
            <dt class="text-xs uppercase tracking-wider text-brand-100">Ученици</dt>
            <dd class="mt-1 font-mono text-3xl font-bold">{school.stats.students}+</dd>
          </div>
          <div class="rounded-xl bg-white/10 px-5 py-4 ring-1 ring-white/20">
            <dt class="text-xs uppercase tracking-wider text-brand-100">От</dt>
            <dd class="mt-1 font-mono text-3xl font-bold">1957</dd>
          </div>
        </dl>
      </div>
    </section>

    {/* Профили (as a choice) */}
    <section class="container py-12 sm:py-16">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">
        Профили за прием
      </h2>
      <p class="mt-2 text-slate-600">
        Изберете профил. Учебните планове и съдържанието са описани в раздел
        <a href="/obuchenie" class="font-medium text-brand-700 hover:text-brand-900">Обучение</a>.
      </p>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2">
        {
          admissionProfiles.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-semibold text-slate-900">{p.title}</h3>
                <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
                  {p.places != null ? `${p.places} места` : "места: предстои"}
                </span>
              </div>
              <p class="mt-3 text-sm text-slate-600">
                Балообразуващи: НВО по БЕЛ и Математика и оценките по
                {" "}{p.formula.gradeA.subject} и {p.formula.gradeB.subject}.
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Калкулатор */}
    <section class="bg-slate-50 py-12 sm:py-16">
      <div class="container">
        <BalCalculator />
      </div>
    </section>

    {/* Важни стъпки + документи */}
    <section class="container py-12 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 class="font-display text-2xl font-bold sm:text-3xl">Стъпки за прием</h2>
          <ol class="mt-6 space-y-4">
            {
              steps.map((s) => (
                <li class="flex gap-4">
                  <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-700 font-mono text-sm font-bold text-white">
                    {s.n}
                  </span>
                  <span class="pt-1 text-slate-700">{s.label}</span>
                </li>
              ))
            }
          </ol>
          <p class="mt-4 text-sm text-slate-500">
            Точните дати следват графика на МОН за съответната година.
          </p>
        </div>
        <div>
          <h2 class="font-display text-2xl font-bold sm:text-3xl">
            Необходими документи
          </h2>
          <ul class="mt-6 space-y-3">
            {
              requiredDocs.map((d) => (
                <li class="flex gap-3 text-slate-700">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />
                  <span>{d}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm text-slate-500">
            Пълният списък се публикува в раздел
            <a href="/dokumenti" class="font-medium text-brand-700 hover:text-brand-900">Документи</a>.
          </p>
        </div>
      </div>
    </section>

    {/* МОН / РУО handoff */}
    <section class="border-t border-slate-200 bg-slate-50">
      <div class="container py-10 sm:py-12">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
          <h2 class="font-display text-xl font-bold text-slate-900">
            Подаване на документи
          </h2>
          <p class="mt-2 text-slate-600">
            Кандидатстването след 7. клас се извършва в електронната система на
            МОН. Следете официалните срокове и указания:
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a
              href="https://www.mon.bg/bg/100199"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-md bg-brand-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-900"
            >
              Прием — МОН <span aria-hidden="true">↗</span>
            </a>
            <a
              href="/kontakti"
              class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
            >
              Въпрос към канцеларията
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
