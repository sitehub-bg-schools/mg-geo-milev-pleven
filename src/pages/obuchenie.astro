---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { school } from "../data/school.ts";

const weekdays = ["Понеделник", "Вторник", "Сряда", "Четвъртък", "Петък"];
const periods = [1, 2, 3, 4, 5, 6, 7];
---

<BaseLayout
  title="Обучение"
  description="Учебни профили, структура на седмицата, учебни планове и форми на подготовка в МГ „Гео Милев“ — Плевен."
>
  <Header />

  <main id="main" class="flex-1">
    <PageHero
      eyebrow="Обучение"
      title="Учебни профили и програма"
      lede="Тук ще намерите информация за учебните профили на гимназията, седмично разписание, учебни планове и форми на подготовка — от задължителна подготовка до избираеми модули и факултативни занимания."
    />

    <section class="container py-12 sm:py-16">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">Профили</h2>
      <ul class="mt-6 space-y-3 text-slate-700">
        {
          school.specializations.map((s) => (
            <li class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="font-semibold text-slate-900">{s.title}</p>
              <p class="mt-1 text-sm text-slate-600">{s.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Седмично разписание — skeleton; ще се попълни с реалните данни. */}
    <section class="border-t border-slate-200 bg-slate-50">
      <div class="container py-12 sm:py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">
              Седмично разписание
            </p>
            <h2 class="mt-3 font-display text-2xl font-bold sm:text-3xl">
              Структура на учебната седмица
            </h2>
          </div>
          <p class="max-w-md text-sm text-slate-600">
            Разписанието се подготвя за публикуване. По-долу е показана
            структурата на седмицата — 7 часа в дните Понеделник – Петък.
          </p>
        </div>

        {/* Desktop / tablet: 5×7 grid */}
        <div
          class="schedule-scroll mt-10 hidden overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm md:block"
          aria-label="Седмично разписание — структура (предстои публикуване)"
        >
          <div class="grid grid-cols-[5rem_repeat(5,minmax(0,1fr))] divide-x divide-slate-100 border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <span class="px-3 py-3 font-semibold">Час</span>
            {
              weekdays.map((day) => (
                <span class="px-3 py-3 font-semibold">{day}</span>
              ))
            }
          </div>
          {
            periods.map((period) => (
              <div
                class="grid grid-cols-[5rem_repeat(5,minmax(0,1fr))] divide-x divide-slate-100 border-b border-slate-100 last:border-b-0"
              >
                <span class="flex items-center px-3 py-3 text-sm font-semibold text-slate-700">
                  {period}.
                </span>
                {
                  weekdays.map((day) => (
                    <span
                      class="flex h-12 items-center justify-center px-3"
                      aria-label={`${day}, ${period}. час — предстои`}
                    >
                      <span
                        class="block h-3 w-full max-w-[8rem] rounded bg-slate-200/80"
                        aria-hidden="true"
                      />
                    </span>
                  ))
                }
              </div>
            ))
          }
        </div>

        {/* Mobile: stacked per-day cards with skeleton rows */}
        <div
          class="mt-8 grid gap-4 md:hidden"
          aria-label="Седмично разписание — структура (предстои публикуване)"
        >
          {
            weekdays.map((day) => (
              <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">
                  {day}
                </p>
                <ul class="mt-3 space-y-2">
                  {
                    periods.map((period) => (
                      <li class="flex items-center gap-3">
                        <span class="w-6 shrink-0 text-xs font-semibold text-slate-500">
                          {period}.
                        </span>
                        <span
                          class="block h-3 flex-1 rounded bg-slate-200/80"
                          aria-hidden="true"
                        />
                      </li>
                    ))
                  }
                </ul>
              </div>
            ))
          }
        </div>

        <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-slate-600">
          Подробните учебни планове и програмата на извънкласните дейности
          ще бъдат добавени тук.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Soft right-edge fade signals horizontal scrollability on narrow viewports
     where the 5×7 grid would otherwise be clipped. Pure CSS mask, no JS. */
  .schedule-scroll {
    -webkit-mask-image: linear-gradient(to right, #000 0, #000 92%, transparent 100%);
    mask-image: linear-gradient(to right, #000 0, #000 92%, transparent 100%);
  }
</style>
