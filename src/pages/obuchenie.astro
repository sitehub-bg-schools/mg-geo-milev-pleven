---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import DocumentList from "../components/DocumentList.astro";
import { school } from "../data/school.ts";
import { categoriesByGroup } from "../data/documents.ts";

const sections = categoriesByGroup("obuchenie");
---

<BaseLayout
  title="Обучение"
  description="Учебни профили, графици, учебни планове, форми на обучение, ДЗИ и учебници в МГ „Гео Милев“ — Плевен."
>
  <Header />

  <main id="main" class="flex-1">
    <PageHero
      eyebrow="Обучение"
      title="Учебни профили и програма"
      lede="Профилите на гимназията, графиците за учебната година, училищните учебни планове, формите на обучение, информацията за зрелостниците и учебниците."
    />

    {/* Профили — real content */}
    <section class="container py-12 sm:py-16">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">Профили</h2>
      <ul class="mt-6 space-y-3 text-slate-700">
        {
          school.specializations.map((s) => (
            <li class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="font-semibold text-slate-900">{s.title}</p>
              <p class="mt-1 text-sm text-slate-600">{s.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Document sub-sections — same DocumentList component as /dokumenti */}
    <section class="border-t border-slate-200 bg-slate-50">
      <div class="container py-12 sm:py-16">
        <nav aria-label="Раздели на обучението" class="mb-12">
          <ul class="flex flex-wrap gap-2">
            {
              sections.map((cat) => (
                <li>
                  <a
                    href={`#${cat.slug}`}
                    class="inline-flex rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-sm font-medium text-slate-700 transition hover:border-brand-500 hover:text-brand-700"
                  >
                    {cat.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="space-y-12">
          {sections.map((cat) => <DocumentList category={cat} />)}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
