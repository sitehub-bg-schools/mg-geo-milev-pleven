---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import PendingChip from "../components/PendingChip.astro";
import NewsCard from "../components/NewsCard.astro";
import { sortNews } from "../data/news.ts";

const sorted = sortNews(await getCollection("news"));
---

<BaseLayout
  title="Новини"
  description="Актуални съобщения, постижения на ученици и преподаватели, предстоящи събития и официални становища на МГ „Гео Милев“ — Плевен."
>
  <Header />

  <main id="main" class="flex-1">
    <PageHero
      eyebrow="Новини"
      title="Последни събития"
      lede="В тази секция публикуваме актуални съобщения, постижения на ученици и учители, предстоящи събития и официални становища на училището."
    />

    <section class="container py-12 sm:py-16">
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          sorted.map((entry) => (
            <li>
              <NewsCard entry={entry} />
            </li>
          ))
        }
      </ul>

      {/* Архив — empty-state card. Older posts beyond the current set. */}
      <article
        class="mt-12 flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:gap-6"
        aria-labelledby="news-archive-title"
      >
        <div
          class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-700"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6"
          >
            <rect x="3" y="4" width="18" height="4" rx="1" />
            <path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8" />
            <line x1="10" y1="12" x2="14" y2="12" />
          </svg>
        </div>
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-3">
            <h2
              id="news-archive-title"
              class="text-lg font-semibold text-slate-900"
            >
              Архив на новините
            </h2>
            <PendingChip />
          </div>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            По-стари публикации от предходни месеци и учебни години ще бъдат
            пренесени тук постепенно.
          </p>
        </div>
      </article>
    </section>
  </main>

  <Footer />
</BaseLayout>
