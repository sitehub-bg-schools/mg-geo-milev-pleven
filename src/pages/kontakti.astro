---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { school } from "../data/school.ts";

// Approximate coordinates for ж.к. „Сторгозия", Плевен.
const lat = 43.4248;
const lng = 24.5912;
const osmUrl = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=16/${lat}/${lng}`;
---

<BaseLayout
  title="Контакти"
  description={`Контакти на ${school.name} — ${school.contact.address}.`}
>
  <Header />

  <main id="main" class="flex-1">
    <PageHero
      eyebrow="Контакти"
      title="Свържете се с нас"
      lede="За въпроси относно прием, документи и текущи дейности — използвайте най-удобния за вас канал по-долу."
    />

    <section class="container py-12 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-2">
        {/* Address & map */}
        <div>
          <h2 class="font-display text-xl font-bold text-slate-900">Адрес</h2>
          <address class="mt-3 not-italic text-slate-700">
            {school.name}<br />
            {school.contact.address}
          </address>
          <a
            href={osmUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:text-brand-900"
          >
            Отвори в OpenStreetMap
            <span aria-hidden="true">↗</span>
          </a>

          <h2 class="mt-10 font-display text-xl font-bold text-slate-900">
            Работно време
          </h2>
          <p class="mt-3 text-slate-700">{school.contact.hours}</p>

          <h2 class="mt-10 font-display text-xl font-bold text-slate-900">
            Транспорт
          </h2>
          <p class="mt-3 text-slate-700">
            До училището може да се стигне с градския транспорт на Плевен:
          </p>
          <ul class="mt-3 space-y-2 text-slate-700">
            <li>
              <span class="font-semibold text-slate-900">Тролеи:</span>{" "}
              {school.transport.trolleybus.join(", ")}
            </li>
            <li>
              <span class="font-semibold text-slate-900">Автобуси:</span>{" "}
              {school.transport.bus.join(", ")}
            </li>
          </ul>
        </div>

        {/* Phones & email */}
        <div class="space-y-8">
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h2 class="font-display text-xl font-bold text-slate-900">
              Телефони
            </h2>
            <dl class="mt-4 divide-y divide-slate-100">
              <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between">
                <dt class="font-semibold text-slate-900">Канцелария</dt>
                <dd class="flex flex-col gap-1 sm:items-end">
                  {
                    school.contact.office.map((phone) => (
                      <a
                        href={`tel:${phone.replace(/[\s/]/g, "")}`}
                        class="text-brand-700 hover:text-brand-900"
                      >
                        {phone}
                      </a>
                    ))
                  }
                </dd>
              </div>
              <div class="flex items-center justify-between py-3">
                <dt class="font-semibold text-slate-900">Директор</dt>
                <dd>
                  <a
                    href={`tel:${school.contact.director.replace(/[\s/]/g, "")}`}
                    class="text-brand-700 hover:text-brand-900"
                  >
                    {school.contact.director}
                  </a>
                </dd>
              </div>
              <div class="flex items-center justify-between py-3">
                <dt class="font-semibold text-slate-900">Зам.-директор</dt>
                <dd>
                  <a
                    href={`tel:${school.contact.deputyDirector.replace(/[\s/]/g, "")}`}
                    class="text-brand-700 hover:text-brand-900"
                  >
                    {school.contact.deputyDirector}
                  </a>
                </dd>
              </div>
            </dl>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h2 class="font-display text-xl font-bold text-slate-900">
              Електронна поща
            </h2>
            <p class="mt-4">
              <a
                href={`mailto:${school.contact.email}`}
                class="text-brand-700 underline underline-offset-2 hover:text-brand-900"
              >
                {school.contact.email}
              </a>
            </p>
            <p class="mt-3 text-sm text-slate-600">
              Отговаряме в рамките на работното време.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
