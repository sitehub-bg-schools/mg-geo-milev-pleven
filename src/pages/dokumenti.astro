---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import DocumentList from "../components/DocumentList.astro";
import { categoriesByGroup } from "../data/documents.ts";

const categories = categoriesByGroup("dokumenti");
---

<BaseLayout
  title="Документи"
  description="Правилници, етичен кодекс, защита на личните данни, бюджет, профил на купувача, заявления и други официални документи на МГ „Гео Милев“ — Плевен."
>
  <Header />

  <main id="main" class="flex-1">
    <PageHero
      eyebrow="Документи"
      title="Официални документи"
      lede="Правилници, стратегия и планове, бюджет, профил на купувача, заявления и друга официална документация на училището. Документите се публикуват и обновяват по категории."
    />

    <section class="container py-12 sm:py-16">
      {/* Quick nav across categories */}
      <nav aria-label="Категории документи" class="mb-12">
        <ul class="flex flex-wrap gap-2">
          {
            categories.map((cat) => (
              <li>
                <a
                  href={`#${cat.slug}`}
                  class="inline-flex rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-sm font-medium text-slate-700 transition hover:border-brand-500 hover:text-brand-700"
                >
                  {cat.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="space-y-12">
        {categories.map((cat) => <DocumentList category={cat} />)}
      </div>

      <p class="mx-auto mt-12 max-w-2xl text-center text-sm text-slate-600">
        За конкретен документ, който все още не е публикуван, можете да се
        обърнете към канцеларията на училището.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
