---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import PendingChip from "../components/PendingChip.astro";

const categories: Array<{ title: string; anchor: string; description: string }> = [
  {
    title: "Правилници",
    anchor: "pravilnici",
    description: "Правилник за дейността, етичен кодекс, вътрешни правила.",
  },
  {
    title: "Учебни планове",
    anchor: "uchebni-planove",
    description: "Годишен план и учебни планове по профили.",
  },
  {
    title: "Бюджет",
    anchor: "byudzhet",
    description: "Тримесечни отчети и годишен бюджет на училището.",
  },
  {
    title: "Профил на купувача",
    anchor: "profil-na-kupuvacha",
    description: "Обществени поръчки и публични покани.",
  },
  {
    title: "Други",
    anchor: "drugi",
    description: "Бланки, заявления и други документи за изтегляне.",
  },
];
---

<BaseLayout
  title="Документи"
  description="Правилници, етичен кодекс, стратегия за развитие, бюджет, годишен план и бланки на МГ „Гео Милев“ — Плевен."
>
  <Header />

  <main id="main" class="flex-1">
    <PageHero
      eyebrow="Документи"
      title="Официални документи"
      lede="В тази секция ще публикуваме правилника за дейността на училището, етичен кодекс, стратегия за развитие, бюджет, годишен план, бланки за заявления и други официални документи, необходими на ученици и родители."
    />

    <section class="container py-12 sm:py-16">
      {/* Grid step-up: 1 → 2 (sm) → 2 (lg, balanced 2+2+1) → 3 (xl). At lg
          a 3-col layout left a lonely 5th card on its own row; the 2-col
          step is intentionally kept until xl. */}
      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {
          categories.map((cat) => (
            <article
              id={cat.anchor}
              class="flex h-full flex-col scroll-mt-24 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"
            >
              <div
                class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-50 text-brand-700"
                aria-hidden="true"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                >
                  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 3 14 8 19 8" />
                  <line x1="9" y1="13" x2="15" y2="13" />
                  <line x1="9" y1="17" x2="13" y2="17" />
                </svg>
              </div>
              <h2 class="mt-4 text-lg font-semibold text-slate-900">
                {cat.title}
              </h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
                {cat.description}
              </p>
              <PendingChip class="mt-4 self-start" />
            </article>
          ))
        }
      </div>

      <p class="mx-auto mt-10 max-w-2xl text-center text-sm text-slate-600">
        До завършването на каталога можете да се обърнете към канцеларията за
        конкретен документ.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
