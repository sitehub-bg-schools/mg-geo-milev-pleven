---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
// Search is powered by Pagefind, which indexes `dist/` after the build
// (`postbuild` script) and serves its UI assets from `/pagefind/`. Those assets
// don't exist during `astro dev`; search works in the built/deployed site.
---

<BaseLayout
  title="Търсене"
  description="Търсене в сайта на МГ „Гео Милев“ — Плевен."
>
  <Header />
  <main id="main" class="flex-1">
    <PageHero
      eyebrow="Търсене"
      title="Търсене в сайта"
      lede="Намерете новини, страници и информация в сайта на гимназията."
    />
    <section class="container py-12 sm:py-16">
      <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
      <div id="search" class="mx-auto max-w-2xl"></div>
      <script src="/pagefind/pagefind-ui.js" is:inline></script>
      <script is:inline>
        window.addEventListener("DOMContentLoaded", () => {
          if (typeof PagefindUI !== "undefined") {
            new PagefindUI({
              element: "#search",
              showSubResults: true,
              showImages: false,
              translations: {
                placeholder: "Търсете в сайта…",
                clear_search: "Изчисти",
                load_more: "Покажи още резултати",
                search_label: "Търсене в сайта",
                zero_results: "Няма резултати за „[SEARCH_TERM]“",
                many_results: "[COUNT] резултата за „[SEARCH_TERM]“",
                one_result: "[COUNT] резултат за „[SEARCH_TERM]“",
                searching: "Търсене за „[SEARCH_TERM]“…",
              },
            });
          }
        });
      </script>
    </section>
  </main>
  <Footer />
</BaseLayout>
