---
export interface Props {
  value: string | number;
  label: string;
  variant?: "light" | "dark";
}

const { value, label, variant = "dark" } = Astro.props;

// "dark" variant: meant to sit on a dark/photo/gradient background.
//   White text on translucent white panel + white ring. Contrast ratio
//   of white (#fff) on brand-700 (#1e40af) ≈ 8.6:1 — passes AA Large.
//
// "light" variant: meant to sit on a light background (white / slate-50).
//   slate-900 text on white panel + brand ring + soft shadow.
//   slate-900 (#0f172a) on white (#fff) ≈ 17:1 — passes AAA.
const wrapperClasses =
  variant === "dark"
    ? "flex flex-col items-center rounded-xl bg-white/10 px-6 py-5 text-center backdrop-blur-sm ring-1 ring-white/25 shadow-sm"
    : "flex flex-col items-center rounded-xl bg-white px-6 py-5 text-center ring-1 ring-slate-200 shadow-md";

const valueClasses =
  variant === "dark"
    ? "font-display text-3xl font-bold text-white sm:text-4xl"
    : "font-display text-3xl font-bold text-slate-900 sm:text-4xl";

const labelClasses =
  variant === "dark"
    ? "mt-1 text-xs font-medium uppercase tracking-wider text-brand-100"
    : "mt-1 text-xs font-medium uppercase tracking-wider text-brand-700";
---

<div class={wrapperClasses}>
  <span class={valueClasses}>{value}</span>
  <span class={labelClasses}>{label}</span>
</div>
