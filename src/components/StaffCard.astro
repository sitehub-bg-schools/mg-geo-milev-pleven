---
/**
 * StaffCard — one person (leadership or teacher). Renders from `role` alone, so
 * it works before names/photos exist (shows a „предстои" chip). When a name is
 * present, shows photo-or-initials, subjects, consultation hours, and a
 * click-to-email link. Photos are shown plain (no duotone) — per the design
 * decision, duotone never applies to real faces.
 */
import PendingChip from "./PendingChip.astro";
import type { StaffMember } from "../data/staff.ts";

export interface Props {
  member: StaffMember;
}

const { member } = Astro.props;
const { role, name, department, subjects, email, consultationHours, photo, bio } =
  member;

const initials = name
  ? name
      .split(/\s+/)
      .map((w) => w[0])
      .slice(0, 2)
      .join("")
  : null;
---

<article class="flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex items-center gap-4">
    {
      photo ? (
        <img
          src={photo}
          alt={name ?? role}
          width="56"
          height="56"
          loading="lazy"
          class="h-14 w-14 shrink-0 rounded-lg object-cover"
        />
      ) : (
        <span
          class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-brand-700 font-display text-lg font-bold text-white"
          aria-hidden="true"
        >
          {initials ?? "—"}
        </span>
      )
    }
    <div class="min-w-0">
      {name && <h3 class="text-base font-semibold text-slate-900">{name}</h3>}
      <p
        class:list={[
          name ? "text-sm text-slate-600" : "text-base font-semibold text-slate-900",
        ]}
      >
        {role}
      </p>
      {department && <p class="mt-0.5 text-xs text-slate-500">{department}</p>}
    </div>
  </div>

  {
    subjects && subjects.length > 0 && (
      <p class="mt-3 text-sm text-slate-600">{subjects.join(", ")}</p>
    )
  }
  {bio && <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{bio}</p>}

  {
    (consultationHours || email) && (
      <div class="mt-4 space-y-1 text-sm">
        {consultationHours && (
          <p class="text-slate-600">
            <span class="font-medium text-slate-700">Консултации:</span>{" "}
            {consultationHours}
          </p>
        )}
        {email && (
          <a href={`mailto:${email}`} class="text-brand-700 hover:text-brand-900">
            {email}
          </a>
        )}
      </div>
    )
  }

  {!name && <div class="mt-4"><PendingChip /></div>}
</article>
