---
/**
 * HubCard — a section entry on a hub landing page. When `href` is set, the whole
 * card is clickable via a stretched link on the title (so the accessible link
 * name is just the title, not the whole card). Without `href`, renders a
 * „Предстои публикуване" placeholder.
 */
import PendingChip from "./PendingChip.astro";

export interface Props {
  title: string;
  description?: string;
  href?: string;
}

const { title, description, href } = Astro.props;
---

<article
  class:list={[
    "relative flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 transition",
    href && "hover:-translate-y-0.5 hover:border-brand-500 hover:shadow-md",
  ]}
>
  <h3 class="text-lg font-semibold text-slate-900">
    {href ? <a href={href} class="after:absolute after:inset-0">{title}</a> : title}
  </h3>
  {
    description && (
      <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
        {description}
      </p>
    )
  }
  <div class="mt-4">
    {
      href ? (
        <span class="inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
          Към секцията <span aria-hidden="true">→</span>
        </span>
      ) : (
        <PendingChip />
      )
    }
  </div>
</article>
