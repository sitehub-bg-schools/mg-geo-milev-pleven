---
/**
 * NewsCard — listing card for a news article, linking to its detail page at
 * /novini/<id>. Shared by the home teaser and the /novini feed so the two stay
 * visually identical.
 */
import type { NewsEntry } from "../data/news.ts";
import { formatNewsDate } from "../data/news.ts";

export interface Props {
  entry: NewsEntry;
}

const { entry } = Astro.props;
const { title, date, excerpt, category, kind } = entry.data;
const href = `/novini/${entry.id}`;
---

<article
  class="relative flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 transition hover:border-brand-500 hover:shadow-sm"
>
  {
    kind === "upcoming-event" && (
      <span class="mb-3 inline-flex w-fit items-center gap-1.5 rounded-full bg-accent-50 px-2.5 py-1 text-xs font-semibold text-accent-700 ring-1 ring-accent-200">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true" />
        Предстоящо събитие
      </span>
    )
  }
  <div class="flex items-center gap-2 text-xs text-slate-500">
    <time datetime={date.toISOString()}>{formatNewsDate(date)}</time>
    {
      category && (
        <>
          <span aria-hidden="true">•</span>
          <span class="font-medium text-brand-700">{category}</span>
        </>
      )
    }
  </div>
  <h3 class="mt-3 text-lg font-semibold text-slate-900">
    <a href={href} class="after:absolute after:inset-0">{title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{excerpt}</p>
  <span
    class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700"
  >
    Прочети повече <span aria-hidden="true">→</span>
  </span>
</article>
