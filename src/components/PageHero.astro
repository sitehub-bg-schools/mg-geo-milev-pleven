---
/**
 * PageHero — shared header band for inner pages.
 *
 * Renders the soft slate-50 band used at the top of every secondary page:
 * eyebrow → H1 → lede → optional CTA, with a thin amber rule beneath the
 * eyebrow as a small brand-recognisable accent.
 *
 * The home page hero (2-col grid, monogram SVG, floating stat badges) is
 * specific enough that wrapping it here would just push complexity into
 * props without saving lines — it stays inline in `index.astro`.
 */
export interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  cta?: { href: string; label: string };
}

const { eyebrow, title, lede, cta } = Astro.props;
---

<section class="bg-slate-50 py-12 sm:py-16">
  <div class="container">
    {
      eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">
          {eyebrow}
        </p>
      )
    }
    <h1 class="mt-3 font-display text-3xl font-bold sm:text-4xl">
      {title}
    </h1>
    <span
      class="mt-4 block h-0.5 w-12 rounded-full bg-accent-500"
      aria-hidden="true"
    ></span>
    {
      lede && (
        <p class="mt-5 max-w-3xl text-slate-700">{lede}</p>
      )
    }
    {
      cta && (
        <div class="mt-6">
          <a
            href={cta.href}
            class="inline-flex items-center justify-center rounded-md bg-brand-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-900"
          >
            {cta.label}
          </a>
        </div>
      )
    }
  </div>
</section>
