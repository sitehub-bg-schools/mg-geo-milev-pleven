---
/**
 * AnnouncementCard — card for the home page "Актуално" strip.
 *
 * Mirrors the news-card visual language but is driven by `announcements.ts`.
 * The whole card is a link when `href` is set; otherwise it renders as a plain
 * article (several real outbound links — PDFs, official pages — aren't in our
 * hands yet, so the card must read fine without one).
 */
import type { Announcement } from "../data/announcements.ts";

export interface Props {
  announcement: Announcement;
}

const { announcement } = Astro.props;
const { title, body, date, tag, upcoming, href } = announcement;

const dateFormatter = new Intl.DateTimeFormat("bg-BG", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const Tag = href ? "a" : "div";
const linkProps = href ? { href } : {};
---

<Tag
  {...linkProps}
  class:list={[
    "flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 transition",
    href && "hover:-translate-y-0.5 hover:border-brand-500 hover:shadow-md",
  ]}
>
  {
    upcoming && (
      <span class="mb-3 inline-flex w-fit items-center gap-1.5 rounded-full bg-accent-50 px-2.5 py-1 text-xs font-semibold text-accent-700 ring-1 ring-accent-200">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true" />
        Предстоящо събитие
      </span>
    )
  }
  <div class="flex items-center gap-2 text-xs text-slate-500">
    <time datetime={date}>{dateFormatter.format(new Date(date))}</time>
    {
      tag && (
        <>
          <span aria-hidden="true">•</span>
          <span class="font-medium text-brand-700">{tag}</span>
        </>
      )
    }
  </div>
  <h3 class="mt-3 text-lg font-semibold text-slate-900">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{body}</p>
  {
    href && (
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
        Прочети повече <span aria-hidden="true">→</span>
      </span>
    )
  }
</Tag>
