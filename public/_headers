# Cloudflare Pages headers. Fingerprinted assets are immutable (1 year);
# HTML must revalidate. Staging appends an X-Robots-Tag: noindex /* block
# in the deploy workflow.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/*
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*
  Cache-Control: public, max-age=0, must-revalidate
